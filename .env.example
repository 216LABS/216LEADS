# 216 Leads environment. Copy to .env and fill in. `pnpm local` fills the
# Supabase values automatically from the local stack when they are blank.
# Never commit .env.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
# production | staging | local. Outside production: STAGING banner, no real mail or charges.
APP_ENV=local
# "/leads" in production and staging (216labs.dev/leads); blank locally.
NEXT_PUBLIC_BASE_PATH=
APP_BASE_URL=http://localhost:3000
CRON_SECRET=change-me-local-cron-secret
ADMIN_EMAILS=
# Staging QA login created by `pnpm seed:staging`
QA_EMAIL=qa@216leads.test
QA_PASSWORD=

# Stripe (test mode keys only: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_EXCLUSIVE_MONTHLY=
STRIPE_PRICE_EXCLUSIVE_ANNUAL=
STRIPE_PRICE_POSTCARD_METERED=
STRIPE_METER_POSTCARDS=postcards_sent

# Resend (blank = emails are written to .data/outbox)
RESEND_API_KEY=
RESEND_FROM_DIGEST=216 Leads <digest@mail.216labs.dev>
RESEND_FROM_TRANSACTIONAL=216 Leads <hello@mail.216labs.dev>
RESEND_WEBHOOK_SECRET=

# Print & mail (test mode only; live sends are refused)
MAIL_PROVIDER=lob
LOB_API_KEY=
LOB_WEBHOOK_SECRET=
LOB_ENV=test
POSTGRID_API_KEY=

# AI business profile wizard (Addendum A). Blank key = the wizard picks the closest preset.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Maps
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAPTILER_KEY=
GOOGLE_STREETVIEW_KEY=

# Bot protection on public forms (blank = check skipped locally)
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Observability (Sentry stays off while blank)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_TOKEN=
# Ops alerts (ingest watchdog); falls back to ADMIN_EMAILS
ALERT_EMAILS=

# Ingest
INGEST_USER_AGENT=216Leads/1.0 (+https://216labs.dev/leads/data)
INGEST_RAW_BUCKET=.data/raw
